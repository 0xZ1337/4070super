# ============================================================
#  Kit PRL+NOCK pour RTX 4070 SUPER — configuration
#  Copie ce fichier en config/miner.env puis remplis tes adresses.
#  Format : CLE=VALEUR (pas d'espaces autour du "=", pas de guillemets)
# ============================================================

# --- Wallets --------------------------------------------------
# Adresse Pearl (commence par prl1...)
PRL_WALLET=prl1REMPLACE_MOI
# Adresse Nockchain NATIVE (base58, sortie de `nockchain-wallet list-active-addresses`).
# PAS une adresse 0x... (wNOCK sur Base) : le pool paie sur Nockchain.
# Laisse vide pour miner uniquement PRL.
NOCK_WALLET=
# Nom du worker tel qu'il apparaîtra sur le pool
WORKER=4070s

# --- Pool -----------------------------------------------------
# Pools connus (voir `python3 prl.py pools`) :
#   luckypool-eu1  luckypool-eu2  (PRL+NOCK merge natif, PROP)
#   herominers-fr  herominers-de  (0 % fee, PPS+, merge à vérifier pour NOCK)
#   custom         -> utilise POOL_URL ci-dessous
POOL=luckypool-eu1
# Uniquement si POOL=custom, ex : stratum+tcp://host:port
POOL_URL=
POOL_PASS=x
# Modèle de login envoyé au pool. Variables : {prl} {nock} {worker}
# LuckyPool / HeroMiners : {prl}+{nock}.{worker}  (sans NOCK -> {prl}.{worker})
USERNAME_TEMPLATE={prl}+{nock}.{worker}

# --- Miner ----------------------------------------------------
# wildrig (0 % fee sur pearlhash, recommandé) | bzminer (2 %) | srbminer (2 %)
MINER=wildrig
# Profil d'OC : eco | balanced | max | tuned (produit par `bench`)
PROFILE=balanced
# Index GPU (laisser vide = toutes les cartes NVIDIA)
GPU_ID=0
# Port de l'API JSON locale du miner (stats)
API_PORT=4068

# --- Économie (facultatif, pour le score "net" du bench) -------
# Prix de l'électricité en €/kWh
KWH_PRICE=0.25
# Revenu estimé PRL+NOCK par TH/s et par jour, en € (regarde ton pool / whattomine)
REVENUE_PER_TH_DAY=
